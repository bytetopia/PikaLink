# Environment configuration for PikaLink

# Frontend environment variables (React)
# Set these when building the frontend for production
REACT_APP_API_URL=https://yourdomain.com/api
REACT_APP_SHORT_LINK_URL=https://yourdomain.com

# Backend environment variables (Go)
# Set these when running the backend in production
CORS_ORIGINS=https://yourdomain.com

# For development, these values will default to localhost
# Development defaults:
# REACT_APP_API_URL=http://localhost:8080/api
# REACT_APP_SHORT_LINK_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:3000
